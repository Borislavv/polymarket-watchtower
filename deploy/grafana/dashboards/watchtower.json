{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "watchtower-main",
  "title": "Polymarket Watchtower",
  "tags": ["polymarket", "watchtower"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "category",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "query": "label_values(watchtower_category_anomalous_trades_total, category)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "severity",
        "type": "custom",
        "query": "info,warning,critical,hard",
        "current": {"text": "All", "value": "$__all"},
        "includeAll": true,
        "multi": true
      },
      {
        "name": "market",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "query": "label_values(watchtower_collect_trades_total, market)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Markets tracked",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "watchtower_discover_markets_tracked"}]
    },
    {
      "type": "stat",
      "title": "Baseline buckets",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "watchtower_baseline_buckets"}]
    },
    {
      "type": "stat",
      "title": "HARD alerts (1h)",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "options": {"colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
      "targets": [{"expr": "sum(increase(watchtower_category_hard_alerts_total[1h]))"}]
    },
    {
      "type": "stat",
      "title": "Single-trade anomalies (1h)",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(increase(watchtower_trade_anomalies_total[1h]))"}]
    },
    {
      "type": "stat",
      "title": "Anomalous USD / 1h",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{"expr": "sum(increase(watchtower_category_anomalous_notional_usd_total[1h]))"}]
    },
    {
      "type": "stat",
      "title": "Telegram alerts ok/err (1h)",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(increase(watchtower_telegram_alerts_sent_total[1h]))", "legendFormat": "sent"},
        {"expr": "sum(increase(watchtower_telegram_alert_errors_total[1h]))", "legendFormat": "errors"}
      ]
    },

    {
      "type": "timeseries",
      "title": "Single-trade anomalies by severity (rate /min)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{
        "expr": "sum by (severity) (rate(watchtower_trade_anomalies_total{category=~\"$category\", severity=~\"$severity\"}[5m])) * 60",
        "legendFormat": "{{severity}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Top categories — anomalous trade count (5m increase)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{
        "expr": "topk(10, sum by (category) (increase(watchtower_category_anomalous_trades_total{severity=~\"$severity\"}[5m])))",
        "legendFormat": "{{category}}"
      }]
    },

    {
      "type": "timeseries",
      "title": "Top categories — anomalous USD (5m increase)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{
        "expr": "topk(10, sum by (category) (increase(watchtower_category_anomalous_notional_usd_total{severity=~\"$severity\"}[5m])))",
        "legendFormat": "{{category}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "CategoryWatchRequired HARD alerts (per category, 5m increase)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{
        "expr": "sum by (category) (increase(watchtower_category_hard_alerts_total{category=~\"$category\"}[5m]))",
        "legendFormat": "{{category}}"
      }]
    },

    {
      "type": "heatmap",
      "title": "Trade-size USD distribution (every trade)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{
        "expr": "sum by (le) (rate(watchtower_trade_size_usd_bucket[5m]))",
        "format": "heatmap",
        "legendFormat": "{{le}}"
      }],
      "options": {"yAxis": {"unit": "currencyUSD"}}
    },
    {
      "type": "heatmap",
      "title": "Anomaly multiplier distribution (notional / baseline median)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{
        "expr": "sum by (le) (rate(watchtower_trade_anomaly_multiplier_bucket[5m]))",
        "format": "heatmap",
        "legendFormat": "{{le}}"
      }]
    },

    {
      "type": "timeseries",
      "title": "Supporting: trade rate / min (per market, $market)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [{
        "expr": "watchtower_window_trade_rate_per_min{market=~\"$market\"}",
        "legendFormat": "{{market}} · {{window}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Supporting: notional rate USD/min (per market, $market)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{
        "expr": "watchtower_window_notional_rate_usd_per_min{market=~\"$market\"}",
        "legendFormat": "{{market}} · {{window}}"
      }]
    },

    {
      "type": "timeseries",
      "title": "Upstream call rate by API/status",
      "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8},
      "targets": [{
        "expr": "sum by (api, status) (rate(watchtower_upstream_requests_total[1m]))",
        "legendFormat": "{{api}} · {{status}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Upstream latency p95",
      "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (api, endpoint, le) (rate(watchtower_upstream_request_duration_seconds_bucket[5m])))",
        "legendFormat": "{{api}} · {{endpoint}}"
      }]
    }
  ]
}
