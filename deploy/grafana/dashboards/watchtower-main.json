{
  "uid": "watchtower-main",
  "title": "Polymarket Watchtower",
  "tags": ["polymarket", "watchtower"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "editable": true,
  "annotations": {"list": []},
  "templating": {
    "list": [
      {
        "name": "category",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "query": "label_values(watchtower_category_anomalous_trades_total, category)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "severity",
        "type": "custom",
        "query": "info,warning,critical,hard",
        "current": {"text": "All", "value": "$__all"},
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Markets tracked",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "watchtower_discover_markets_tracked", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Baseline buckets",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "watchtower_baseline_buckets", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Single-trade anomalies (1h)",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "sum(increase(watchtower_trade_anomalies_total[1h]))", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HARD alerts (1h)",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {"colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
      "targets": [{"expr": "sum(increase(watchtower_category_hard_alerts_total[1h]))", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Anomalous USD / 1h",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{"expr": "sum(increase(watchtower_category_anomalous_notional_usd_total[1h]))", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Telegram sent / errors (1h)",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "sum(increase(watchtower_telegram_alerts_sent_total[1h]))", "legendFormat": "sent", "refId": "A"},
        {"expr": "sum(increase(watchtower_telegram_alert_errors_total[1h]))", "legendFormat": "errors", "refId": "B"}
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "MM-suppressed (24h)",
      "gridPos": {"x": 0, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "sum(increase(watchtower_filter_alert_mm_suppressed_total[24h]))", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Unknown-lifecycle skipped (24h)",
      "gridPos": {"x": 4, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "increase(watchtower_filter_lifecycle_unknown_skipped_total[24h])", "refId": "A"}]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Pending alerts (approx)",
      "gridPos": {"x": 8, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Approximation: emitted − sent. Exact: SELECT count(*) FROM polymarket_alerts WHERE status='pending'.",
      "targets": [{"expr": "sum(watchtower_trade_anomalies_total) + sum(watchtower_accumulation_alerts_total) + sum(watchtower_category_hard_alerts_total) - sum(watchtower_telegram_alerts_sent_total)", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Failed alerts (24h)",
      "gridPos": {"x": 12, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}},
      "targets": [{"expr": "sum(increase(watchtower_telegram_alert_errors_total[24h]))", "refId": "A"}]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Postgres trades (total)",
      "gridPos": {"x": 16, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Proxy: cumulative ingest counters across all markets.",
      "targets": [{"expr": "sum(watchtower_collect_trades_total)", "refId": "A"}]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Backfill USD/min (5m)",
      "gridPos": {"x": 20, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{"expr": "sum(rate(watchtower_collect_notional_usd_total[5m])) * 60", "refId": "A"}]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Single-trade anomalies by severity (rate / min)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "sum by (severity) (rate(watchtower_trade_anomalies_total{category=~\"$category\", severity=~\"$severity\"}[5m])) * 60", "legendFormat": "single:{{severity}}", "refId": "A"},
        {"expr": "sum by (severity) (rate(watchtower_accumulation_alerts_total{category=~\"$category\", severity=~\"$severity\"}[5m])) * 60", "legendFormat": "accumulation:{{severity}}", "refId": "B"},
        {"expr": "sum(rate(watchtower_category_hard_alerts_total{category=~\"$category\"}[5m])) * 60", "legendFormat": "cluster (hard)", "refId": "C"},
        {"expr": "sum by (kind) (rate(watchtower_quietmarket_alerts_total[5m])) * 60", "legendFormat": "quietmarket:{{kind}}", "refId": "D"}
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Single-trade anomaly axis (rate / 5m)",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "sum by (axis) (rate(watchtower_trade_anomaly_axis_total[5m]))", "legendFormat": "{{axis}}", "refId": "A"}
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Top categories — anomalous trade count (5m)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "topk(10, sum by (category) (increase(watchtower_category_anomalous_trades_total{severity=~\"$severity\"}[5m])))",
        "legendFormat": "{{category}}",
        "refId": "A"
      }]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Top categories — anomalous USD (5m)",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{
        "expr": "topk(10, sum by (category) (increase(watchtower_category_anomalous_notional_usd_total{severity=~\"$severity\"}[5m])))",
        "legendFormat": "{{category}}",
        "refId": "A"
      }]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "CategoryWatchRequired HARD alerts (per category, 5m)",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (category) (increase(watchtower_category_hard_alerts_total{category=~\"$category\"}[5m]))",
        "legendFormat": "{{category}}",
        "refId": "A"
      }]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Telegram sent vs errors (rate / 5m)",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "sum by (severity) (rate(watchtower_telegram_alerts_sent_total[5m]))", "legendFormat": "sent:{{severity}}", "refId": "A"},
        {"expr": "sum by (severity) (rate(watchtower_telegram_alert_errors_total[5m]))", "legendFormat": "err:{{severity}}", "refId": "B"}
      ]
    },
    {
      "id": 30,
      "type": "heatmap",
      "title": "Trade-size USD distribution (every trade)",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (le) (rate(watchtower_trade_size_usd_bucket[5m]))",
        "format": "heatmap",
        "legendFormat": "{{le}}",
        "refId": "A"
      }],
      "options": {"yAxis": {"unit": "currencyUSD"}}
    },
    {
      "id": 31,
      "type": "heatmap",
      "title": "Anomaly multiplier distribution (effective)",
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (le) (rate(watchtower_trade_anomaly_multiplier_bucket[5m]))",
        "format": "heatmap",
        "legendFormat": "{{le}}",
        "refId": "A"
      }]
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Upstream API latency (p50 / p95 / p99)",
      "gridPos": {"x": 0, "y": 40, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (api, le) (rate(watchtower_upstream_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{api}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (api, le) (rate(watchtower_upstream_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{api}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (api, le) (rate(watchtower_upstream_request_duration_seconds_bucket[5m])))", "legendFormat": "p99 {{api}}", "refId": "C"}
      ]
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Upstream errors (rate / 5m by status)",
      "gridPos": {"x": 12, "y": 40, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (api, status) (rate(watchtower_upstream_requests_total{status!~\"2..\"}[5m]))",
        "legendFormat": "{{api}}:{{status}}",
        "refId": "A"
      }]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Trade ingest rate (per market, top 10)",
      "gridPos": {"x": 0, "y": 48, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "topk(10, sum by (market) (rate(watchtower_collect_trades_total[5m])))",
        "legendFormat": "{{market}}",
        "refId": "A"
      }]
    },
    {
      "id": 50,
      "type": "timeseries",
      "title": "Persistence: trade upserts vs duplicates (rate / 5m)",
      "gridPos": {"x": 0, "y": 56, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "rate(watchtower_persist_trades_upserted_total[5m])", "legendFormat": "upserted", "refId": "A"},
        {"expr": "rate(watchtower_persist_trades_duplicates_skipped_total[5m])", "legendFormat": "duplicates (ON CONFLICT)", "refId": "B"}
      ]
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "Persistence: market + outcome + trader upserts (rate / 5m)",
      "gridPos": {"x": 12, "y": 56, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "rate(watchtower_persist_markets_upserted_total[5m])", "legendFormat": "markets", "refId": "A"},
        {"expr": "rate(watchtower_persist_market_outcomes_upserted_total[5m])", "legendFormat": "outcomes", "refId": "B"},
        {"expr": "rate(watchtower_persist_traders_upserted_total[5m])", "legendFormat": "traders", "refId": "C"}
      ]
    },
    {
      "id": 52,
      "type": "stat",
      "title": "Markets soft-deleted (24h)",
      "gridPos": {"x": 0, "y": 64, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "increase(watchtower_persist_markets_soft_deleted_total[24h])", "refId": "A"}]
    },
    {
      "id": 53,
      "type": "stat",
      "title": "Markets purged (24h)",
      "gridPos": {"x": 6, "y": 64, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "increase(watchtower_sanity_markets_purged_total[24h])", "refId": "A"}]
    },
    {
      "id": 54,
      "type": "stat",
      "title": "Markets resumed (24h)",
      "gridPos": {"x": 12, "y": 64, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "increase(watchtower_sanity_markets_resumed_total[24h])", "refId": "A"}]
    },
    {
      "id": 55,
      "type": "stat",
      "title": "Stats summaries sent (24h)",
      "gridPos": {"x": 18, "y": 64, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "increase(watchtower_stats_summaries_sent_total[24h])", "refId": "A"}]
    },
    {
      "id": 56,
      "type": "timeseries",
      "title": "Backfill: pages fetched (rate / 5m)",
      "gridPos": {"x": 0, "y": 68, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "rate(watchtower_backfill_pages_fetched_total[5m])", "legendFormat": "pages/s", "refId": "A"}]
    },
    {
      "id": 57,
      "type": "timeseries",
      "title": "Backfill: terminal runs by status (rate / 15m)",
      "gridPos": {"x": 12, "y": 68, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (status) (rate(watchtower_backfill_runs_total[15m]))",
        "legendFormat": "{{status}}",
        "refId": "A"
      }]
    },
    {
      "id": 60,
      "type": "timeseries",
      "title": "Accumulation alerts by window (rate / 15m)",
      "gridPos": {"x": 0, "y": 76, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (window, severity) (rate(watchtower_accumulation_alerts_total[15m]))",
        "legendFormat": "{{window}} · {{severity}}",
        "refId": "A"
      }]
    },
    {
      "id": 61,
      "type": "timeseries",
      "title": "Ownership concentration alerts (rate / 15m)",
      "gridPos": {"x": 12, "y": 76, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (severity) (rate(watchtower_ownership_alerts_total[15m]))",
        "legendFormat": "{{severity}}",
        "refId": "A"
      }]
    },
    {
      "id": 62,
      "type": "timeseries",
      "title": "New-wallet reasons attached (rate / 15m)",
      "gridPos": {"x": 0, "y": 84, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (kind, severity) (rate(watchtower_newwallet_reasons_attached_total[15m]))",
        "legendFormat": "{{kind}} · {{severity}}",
        "refId": "A"
      }]
    },
    {
      "id": 70,
      "type": "timeseries",
      "title": "Signal quality · directional correctness (24h rolling rate)",
      "description": "Resolved-alert success rate over the last 24h, computed from watchtower_alert_outcomes_total. Bias-aware: pending and unavailable outcomes are excluded from the denominator. Read as 'of alerts whose markets have resolved in the last 24h, what fraction were directionally correct?'",
      "gridPos": {"x": 0, "y": 92, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum(increase(watchtower_alert_outcomes_total{status=\"resolved_correct\"}[24h])) / clamp_min(sum(increase(watchtower_alert_outcomes_total{status=~\"resolved_correct|resolved_wrong\"}[24h])), 1)",
        "legendFormat": "success rate (24h)",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 71,
      "type": "timeseries",
      "title": "Signal quality · resolved vs pending (count / 1h)",
      "description": "Stacked counts of new outcome verdicts per hour. Pending = market hasn't resolved yet; ambiguous = winning price never cleared the threshold; unavailable = market not in upstream snapshot.",
      "gridPos": {"x": 12, "y": 92, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (status) (increase(watchtower_alert_outcomes_total[1h]))",
        "legendFormat": "{{status}}",
        "refId": "A"
      }]
    },
    {
      "id": 72,
      "type": "timeseries",
      "title": "Signal quality by severity (24h success rate)",
      "description": "Per-severity directional-correctness rate. Sample sizes are usually small at Critical/Hard; treat as directional, not statistically stable.",
      "gridPos": {"x": 0, "y": 100, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (severity) (increase(watchtower_alert_outcomes_total{status=\"resolved_correct\"}[24h])) / clamp_min(sum by (severity) (increase(watchtower_alert_outcomes_total{status=~\"resolved_correct|resolved_wrong\"}[24h])), 1)",
        "legendFormat": "{{severity}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 73,
      "type": "timeseries",
      "title": "Signal quality by alert kind (24h success rate)",
      "description": "Per-alert-kind directional-correctness rate. trade_anomaly vs accumulation vs category_watch vs ownership_concentration.",
      "gridPos": {"x": 12, "y": 100, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (kind) (increase(watchtower_alert_outcomes_total{status=\"resolved_correct\"}[24h])) / clamp_min(sum by (kind) (increase(watchtower_alert_outcomes_total{status=~\"resolved_correct|resolved_wrong\"}[24h])), 1)",
        "legendFormat": "{{kind}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 74,
      "type": "timeseries",
      "title": "Telegram outcome reactions (rate / 15m)",
      "description": "setMessageReaction results. 'unsupported' = Telegram refused (channel doesn't allow reactions, bot has no rights, paid reaction needed); 'failed' = retryable transport error.",
      "gridPos": {"x": 0, "y": 108, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (status) (rate(watchtower_telegram_reactions_total[15m]))",
        "legendFormat": "{{status}}",
        "refId": "A"
      }]
    },
    {
      "id": 75,
      "type": "stat",
      "title": "Signal reports sent (24h)",
      "description": "Scheduled signal-quality reports successfully delivered to Telegram in the last 24h.",
      "gridPos": {"x": 12, "y": 108, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum(increase(watchtower_signal_reports_sent_total{status=\"sent\"}[24h]))",
        "refId": "A"
      }]
    },
    {
      "id": 76,
      "type": "stat",
      "title": "Signal reports failed (24h)",
      "description": "Scheduled reports that failed to send. Non-zero usually means Telegram chat misconfigured or upstream rate-limit.",
      "gridPos": {"x": 18, "y": 108, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum(increase(watchtower_signal_reports_sent_total{status=\"failed\"}[24h]))",
        "refId": "A"
      }]
    },
    {
      "id": 80,
      "type": "row",
      "title": "PAL · Proof of Alert Value",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 116, "w": 24, "h": 1}
    },
    {
      "id": 81,
      "type": "timeseries",
      "title": "PAL · cumulative realized edge",
      "description": "Cumulative sum of (success_binary − implied_probability_at_alert) over resolved alerts. A green line that trends UP is the proof-of-value signal: our alerts on average beat what the market itself priced. A flat or descending line means alerts are not adding value over the market's own probability.",
      "gridPos": {"x": 0, "y": 117, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum(increase(watchtower_alert_realized_edge_sum[$__range]))",
        "legendFormat": "cumulative edge",
        "refId": "A"
      }]
    },
    {
      "id": 82,
      "type": "timeseries",
      "title": "PAL · avg realized edge by severity (24h rolling)",
      "description": "Average edge per resolved alert, broken down by severity. Critical/Hard should out-edge Info if the severity ladder is meaningful.",
      "gridPos": {"x": 12, "y": 117, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (severity) (rate(watchtower_alert_realized_edge_sum[24h])) / clamp_min(sum by (severity) (rate(watchtower_alert_realized_edge_count[24h])), 0.00001)",
        "legendFormat": "{{severity}}",
        "refId": "A"
      }]
    },
    {
      "id": 83,
      "type": "timeseries",
      "title": "PAL · avg realized edge by alert kind (24h rolling)",
      "description": "Edge per kind: trade_anomaly vs accumulation vs category_watch vs ownership_concentration. If one kind contributes most of the positive edge, weight your operator attention there.",
      "gridPos": {"x": 0, "y": 125, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{
        "expr": "sum by (kind) (rate(watchtower_alert_realized_edge_sum[24h])) / clamp_min(sum by (kind) (rate(watchtower_alert_realized_edge_count[24h])), 0.00001)",
        "legendFormat": "{{kind}}",
        "refId": "A"
      }]
    },
    {
      "id": 84,
      "type": "timeseries",
      "title": "PAL · weighted success rate (24h rolling)",
      "description": "Severity-weighted success rate: sum(weight × success) / sum(weight). Weights: Info=1 Warning=3 Critical=10 Hard=25. A flat rate while raw Info volume rises means we're adding noise without adding edge.",
