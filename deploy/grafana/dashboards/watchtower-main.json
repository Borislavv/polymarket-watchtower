    {
      "id": 85,
      "type": "table",
      "title": "PAL · calibration by implied-probability bucket (24h)",
      "description": "For each implied-probability bucket, the share of resolved alerts that turned out correct. The market thinks the 10-20% bucket should win 10-20% of the time; if it wins MORE than that, we have signal in the long-shot region. The most informative buckets are 0-10 / 10-20 / 20-30.",
      "gridPos": {"x": 0, "y": 133, "w": 24, "h": 9},
